# Copy the lines you need into a file named `.env.local` (it is not committed)
# and restart `npm run dev`. Only public values belong here: everything that
# starts with VITE_ ends up in the browser code, so never put a secret in it.

# Where the backend lives (not used while the app runs on demo data)
# VITE_API_URL=http://localhost:8000

# Where the phone app is in its store. Phones of that kind are then offered the
# app first, with a "Continue in browser" link. Leave both out until the app is
# published: nothing changes for anyone.
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.globosoft.pms
# VITE_IOS_APP_URL=https://apps.apple.com/app/id0000000000

# Which demo data to start with: "sample" (default) or "empty"
# VITE_DEMO_DATA=empty
